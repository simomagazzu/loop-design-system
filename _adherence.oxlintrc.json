{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/button/**",
              "components/chips/**",
              "components/content/**",
              "components/data/**",
              "components/disclosure/**",
              "components/fields/**",
              "components/icon/**",
              "components/layout/**",
              "components/people/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins))/i]",
        "message": "Font not provided by the design system. Available: Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|multiple|defaultOpen|headingLevel|className|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, multiple, defaultOpen, headingLevel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|icon|loading|disabled|onClick|type|children|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, icon, loading, disabled, onClick, type, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:client|logo|sector|headline|result|levers|image|slotId|href|featured|className|key|ref|className|style|children)$/]",
        "message": "<CaseCard> doesn't accept that prop. Declared props: client, logo, sector, headline, result, levers, image, slotId, href, featured, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|multi|className|key|ref|className|style|children)$/]",
        "message": "<ChoiceChips> doesn't accept that prop. Declared props: label, options, value, onChange, multi, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClientLogoWall'] > JSXAttribute > JSXIdentifier[name!=/^(?:clients|columns|slots|note|label|className|key|ref|className|style|children)$/]",
        "message": "<ClientLogoWall> doesn't accept that prop. Declared props: clients, columns, slots, note, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreFramework'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|right|items|claim|tone|className|key|ref|className|style|children)$/]",
        "message": "<CoreFramework> doesn't accept that prop. Declared props: left, right, items, claim, tone, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoreFramework'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|navy)$/]",
        "message": "<CoreFramework> tone must be one of 'light' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|counts|className|key|ref|className|style|children)$/]",
        "message": "<FilterChips> doesn't accept that prop. Declared props: label, options, value, onChange, counts, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|about|columns|legal|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: logo, about, columns, legal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Framework'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|claim|items|tone|diagram|className|key|ref|className|style|children)$/]",
        "message": "<Framework> doesn't accept that prop. Declared props: name, claim, items, tone, diagram, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Framework'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|navy)$/]",
        "message": "<Framework> tone must be one of 'light' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|desc|items|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href, desc, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Icon> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|error|required|disabled|id|name|value|placeholder|onChange|className|type|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, help, error, required, disabled, id, name, value, placeholder, onChange, className, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:series|title|meta|href|className|key|ref|className|style|children)$/]",
        "message": "<InsightCard> doesn't accept that prop. Declared props: series, title, meta, href, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute[name.name='series'] > Literal[value!=/^(?:In The Loop|Creative\\.Lab|Ecom\\.Lab|Podcast)$/]",
        "message": "<InsightCard> series must be one of 'In The Loop' | 'Creative.Lab' | 'Ecom.Lab' | 'Podcast'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyFigures'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|items|footnote|className|key|ref|className|style|children)$/]",
        "message": "<KeyFigures> doesn't accept that prop. Declared props: lead, items, footnote, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Levers'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|footnote|className|key|ref|className|style|children)$/]",
        "message": "<Levers> doesn't accept that prop. Declared props: items, footnote, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Partner'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|note|src|file|h|key|ref|className|style|children)$/]",
        "message": "<Partner> doesn't accept that prop. Declared props: name, status, note, src, file, h."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnersCollage'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|intro|partners|slots|className|key|ref|className|style|children)$/]",
        "message": "<PartnersCollage> doesn't accept that prop. Declared props: title, intro, partners, slots, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|expertise|photo|slotId|linkedin|featured|className|key|ref|className|style|children)$/]",
        "message": "<PersonCard> doesn't accept that prop. Declared props: name, role, expertise, photo, slotId, linkedin, featured, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessSteps'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|note|className|key|ref|className|style|children)$/]",
        "message": "<ProcessSteps> doesn't accept that prop. Declared props: steps, note, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|name|role|company|className|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: text, name, role, company, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|intro|action|as|stack|id|className|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, intro, action, as, stack, id, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionHeader> as must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|error|required|disabled|id|name|value|placeholder|onChange|className|options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, help, error, required, disabled, id, name, value, placeholder, onChange, className, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|initial|label|className|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, initial, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamCarousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|people|slots|className|key|ref|className|style|children)$/]",
        "message": "<TeamCarousel> doesn't accept that prop. Declared props: title, people, slots, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|error|required|disabled|id|name|value|placeholder|onChange|className|rows|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, help, error, required, disabled, id, name, value, placeholder, onChange, className, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|label|client|channel|signature|children|className|key|ref|className|style|children)$/]",
        "message": "<WorkFrame> doesn't accept that prop. Declared props: format, label, client, channel, signature, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkFrame'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:feed|story|email|dashboard|wide)$/]",
        "message": "<WorkFrame> format must be one of 'feed' | 'story' | 'email' | 'dashboard' | 'wide'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
